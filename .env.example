# Copy this file to .env and fill in the values before running docker compose.

# Campfire rails secrets
SERVICE_BASE64_64_CAMPFIRE=devcampfire
SECRET_KEY_BASE=dev_secret_key_base

# LiveKit credentials (livekit-server will use LIVEKIT_KEYS to map key:secret)
LIVEKIT_API_KEY=livekit_dev_api_key_1234567890abcdefABCDEF
LIVEKIT_API_SECRET=livekit_dev_secret_1234567890abcdefABCDEF
LIVEKIT_URL=https://livekit.localhost

# TLS hosts (set to your actual domain in production)
CAMPFIRE_HOST=campfire.localhost
LIVEKIT_HOST=livekit.localhost
# Provide either a valid cert/key tuple or let Caddy issue an internal cert for dev.
# Example for static certs: TLS_DIRECTIVE=tls /certs/livekit.crt /certs/livekit.key
TLS_DIRECTIVE=tls internal

# Optional services
disable_ssl=true
ssl_domain=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SENTRY_DSN=
